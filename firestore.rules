rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // admins are listed in admins/{uid}, written only from the Firebase console
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // a moment as the app writes it (toISOString), not after today: documents everyone downloads stay small, and the
    // admins' notifications (scripts/notify.mjs) take the newer ones as new
    function stamp(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z')
        && timestamp.date(int(v[0:4]), int(v[5:7]), int(v[8:10])) <= request.time;
    }
    // a text field of `d`, from `min` to `max` characters
    function text(d, field, min, max) {
      return d.get(field, null) is string && d[field].size() >= min && d[field].size() <= max;
    }
    // a field that is missing, null, or text up to `max` characters
    function optional(d, field, max) {
      return d.get(field, null) == null || text(d, field, 0, max);
    }

    // each account can see whether it is an admin, and nobody can make themselves one
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // each user can read and write only their own data
    match /users/{userId} {
      // the player the account points to (circuitMe) changes only once the account's claim on it is gone, as the
      // claim rules trust circuitMe to keep one claim per account
      function releasesClaim() {
        let old = resource == null ? null : resource.data.get('circuitMe', null);
        return old == null
          || request.resource.data.get('circuitMe', null) == old
          || !existsAfter(/databases/$(database)/documents/claims/$(old))
          || getAfter(/databases/$(database)/documents/claims/$(old)).data.uid != request.auth.uid;
      }
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && releasesClaim();
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // a deck its owner shared (src/lib/decks.ts Visibility): whoever has the link opens an unlisted or public one,
      // even without signing in, and a missing one reads as missing; only the public ones can be listed
      match /decks/{deckId} {
        allow get: if resource == null || resource.data.get('visibility', 'private') in ['unlisted', 'public'];
        allow list: if resource.data.get('visibility', 'private') == 'public';
      }
    }

    // circuit players claimed by an account ("this is me"): everyone can see who is linked (and verified),
    // a free player can be claimed once, and only the claimer can change or release it
    match /claims/{playerKey} {
      // a picture every viewer's browser loads: from that site only, and without quotes or brackets, which in a CSS
      // url("…") would add an image from anywhere
      function optionalUrl(field, site) {
        return request.resource.data.get(field, null) == null
          || (request.resource.data[field] is string && request.resource.data[field].size() <= 1000
            && request.resource.data[field].matches(site + '/[-_./A-Za-z0-9=?]*'));
      }
      // the account's Google picture, the art of a card
      function pictures() {
        return optionalUrl('photo', 'https://lh[0-9][.]googleusercontent[.]com')
          && optionalUrl('coverArt', 'https://cards[.]scryfall[.]io');
      }

      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'at'])
        && stamp(request.resource.data.at)
        // every app downloads all the claims: no oversized names
        && optional(request.resource.data, 'name', 200)
        && pictures()
        // the account must point to this very player, so one account holds one claim
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.circuitMe == playerKey
        // an account whose claim an admin revoked can't take that player back
        && !(exists(/databases/$(database)/documents/revoked/$(playerKey))
          && get(/databases/$(database)/documents/revoked/$(playerKey)).data.uid == request.auth.uid);
      // the claimer can also customise their page: the art behind their picture and their favourite deck; the
      // "verified" tick stays as an admin left it
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'at', 'coverName', 'coverArt', 'deck', 'verified', 'verifiedBy', 'verifiedIn'])
        && request.resource.data.get('verified', null) == resource.data.get('verified', null)
        && request.resource.data.get('verifiedBy', null) == resource.data.get('verifiedBy', null)
        && request.resource.data.get('verifiedIn', null) == resource.data.get('verifiedIn', null)
        && (request.resource.data.get('at', null) == resource.data.get('at', null) || stamp(request.resource.data.get('at', null)))
        && optional(request.resource.data, 'name', 200)
        && pictures()
        && optional(request.resource.data, 'coverName', 150)
        && optional(request.resource.data, 'deck', 200);
      // an admin can only clear that customisation, leaving the claim as it is
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coverName', 'coverArt', 'deck'])
        && request.resource.data.get('coverName', null) == null
        && request.resource.data.get('coverArt', null) == null
        && request.resource.data.get('deck', null) == null;
      // an admin who knows the player gives (or takes back) the "verified" tick, and changes nothing else; a tick
      // given by a TO stops being theirs
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedBy', 'verifiedIn'])
        && request.resource.data.get('verified', false) is bool
        && request.resource.data.get('verifiedBy', null) == null
        && request.resource.data.get('verifiedIn', null) == null;
      // a TO gives it (never takes it back) to the account that registered this player at one of their tournaments,
      // signing it with their uid and the tournament
      allow update: if request.auth != null
        && resource.data.get('verified', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'verifiedBy', 'verifiedIn'])
        && request.resource.data.verified == true
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedIn is string
        && manages(get(/databases/$(database)/documents/tournaments/$(request.resource.data.verifiedIn)).data.drive)
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.verifiedIn)/players/$(playerKey)).data.get('uid', null) == resource.data.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // the tournament sheets read by the nightly meta update, one per drive file id: public (the update reads them
    // without signing in), kept by the admins
    match /sources/{drive} {
      function validSource(d) {
        return d.keys().hasOnly(['drive', 'kind', 'name', 'date', 'circuit', 'year', 'season', 'league', 'venue', 'zone', 'tos', 'at', 'by'])
          && d.drive == drive
          && drive.matches('[-_A-Za-z0-9]{20,100}')
          && d.by == request.auth.uid
          && optional(d, 'circuit', 150)
          && optional(d, 'venue', 80)
          // events: the league whose organizers run it, and organizers assigned by hand (uids)
          && optional(d, 'zone', 80)
          && (d.get('tos', null) == null || (d.tos is list && d.tos.size() <= 20))
          && ((d.kind in ['l1', 'l2']
              && text(d, 'name', 1, 80)
              && d.get('date', null) is string
              && d.date.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]'))
            || (d.kind in ['league', 'online']
              && d.get('year', null) is int
              && d.year >= 2020 && d.year <= 2100
              && d.get('season', null) in ['s1', 's2']
              && text(d, 'league', 1, 80)));
      }

      allow read: if true;
      allow create, update: if isAdmin() && validSource(request.resource.data);
      allow delete: if isAdmin();
    }

    // tournament organizers (TO): verified circuit players promoted by an admin, with the leagues they run (also the
    // zones of the level 1 and 2 tournaments). Only admins write them; each TO reads their own
    match /organizers/{uid} {
      function claimOf(d) {
        return get(/databases/$(database)/documents/claims/$(d.player)).data;
      }
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['player', 'name', 'leagues', 'at', 'by'])
        && request.resource.data.player is string
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.leagues is list && request.resource.data.leagues.size() <= 30
        && request.resource.data.by == request.auth.uid
        // the account holding a verified claim on that player, and no other
        && claimOf(request.resource.data).uid == uid
        && claimOf(request.resource.data).get('verified', false) == true;
      allow delete: if isAdmin();
    }

    // tournaments run in the app (src/lib/tournaments.ts), one per sheet (a stage of a league, or a level 1 or 2): everyone
    // follows them, even without signing in; the organizers who run that sheet, and the admins, run them
    function runs(drive) {
      let s = get(/databases/$(database)/documents/sources/$(drive)).data;
      let o = get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data;
      return (s.kind in ['l1', 'l2'] && (request.auth.uid in s.get('tos', []) || s.get('zone', '') in o.leagues))
        || (s.kind == 'league' && s.league in o.leagues);
    }
    function manages(drive) {
      return request.auth != null && (isAdmin() || runs(drive));
    }
    match /tournaments/{tid} {
      function valid(d) {
        return d.keys().hasOnly(['drive', 'kind', 'name', 'stage', 'date', 'status', 'rounds', 'cut', 'round', 'started', 'filed', 'code', 'published', 'time', 'place', 'address', 'hidden', 'at', 'by'])
          && d.drive is string
          // its id is its sheet (and stage): one tournament for each
          && ((d.kind in ['l1', 'l2'] && tid == d.drive && d.get('stage', null) == null)
            || (d.kind == 'league' && d.stage is int && d.stage >= 1 && d.stage <= 60 && tid == d.drive + '~' + string(d.stage)))
          && d.kind == get(/databases/$(database)/documents/sources/$(d.drive)).data.kind
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.date is string && d.date.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]')
          && d.status in ['open', 'swiss', 'cut', 'done']
          && d.rounds is int && d.rounds >= 0 && d.rounds <= 15
          && d.cut in [0, 2, 4, 8]
          && d.round is int && d.round >= 0 && d.round <= 30
          && d.get('filed', false) is bool
          // the registration code: none once round 1 starts
          && (d.get('code', null) == null || (d.code is string && d.code.matches('[A-Z0-9]{6}')))
          // for the calendar: start time, venue and its address, or kept out of it by the TO
          && (d.get('time', null) == null || (d.time is string && d.time.matches('[0-2][0-9]:[0-5][0-9]')))
          && (d.get('place', null) == null || (d.place is string && d.place.size() <= 100))
          && (d.get('address', null) == null || (d.address is string && d.address.size() <= 200))
          && d.get('hidden', false) is bool
          // what the Apps Script wrote into the sheet, to take it off again
          && (d.get('published', null) == null
            || (d.published is map && d.published.keys().hasOnly(['tab', 'first', 'rows', 'players', 'commanders'])
              && d.published.tab is string && d.published.first is int && d.published.rows is int
              && d.published.players is list && d.published.players.size() <= 300
              && d.published.commanders is list && d.published.commanders.size() <= 300))
          && d.at is string && d.by is string;
      }
      allow read: if true;
      allow create: if manages(request.resource.data.drive)
        && valid(request.resource.data)
        && request.resource.data.status == 'open'
        && request.resource.data.round == 0
        && request.resource.data.started == null
        && request.resource.data.get('filed', false) == false
        && request.resource.data.get('published', null) == null
        && request.resource.data.by == request.auth.uid;
      // the round's clock starts at the server's time, the same for every phone
      allow update: if manages(resource.data.drive)
        && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'status', 'rounds', 'cut', 'round', 'started', 'filed', 'code', 'published', 'time', 'place', 'address', 'hidden'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['started']) || request.resource.data.started == request.time);
      allow delete: if manages(resource.data.drive);

      function tour() {
        return get(/databases/$(database)/documents/tournaments/$(tid)).data;
      }
      function managed() {
        return manages(tour().drive);
      }
      // the account holding the claim on this circuit player ("this is me"), verified or not
      function holds(key) {
        return request.auth != null
          && exists(/databases/$(database)/documents/claims/$(key))
          && get(/databases/$(database)/documents/claims/$(key)).data.uid == request.auth.uid;
      }
      function verified(key) {
        return holds(key) && get(/databases/$(database)/documents/claims/$(key)).data.get('verified', false) == true;
      }
      function round(d, field) {
        return d.get(field, null) == null || (d[field] is int && d[field] >= 0 && d[field] <= 30);
      }
      match /players/{key} {
        // the commanders are secret until round 1: while registration is open each one is in the player's private
        // document, and here only `secret` says it was given. The write that starts round 1 brings them here
        function revealed(d) {
          return d.get('commander', null) == null
            || getAfter(/databases/$(database)/documents/tournaments/$(tid)).data.status != 'open'
            || (resource != null && d.commander == resource.data.get('commander', null)); // given before this rule
        }
        allow read: if true;
        allow create, update: if managed()
          && key.size() <= 200
          && request.resource.data.keys().hasOnly(['name', 'commander', 'secret', 'joined', 'drop', 'uid', 'pending', 'deck', 'invalid', 'list', 'at', 'by'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && (request.resource.data.get('commander', null) == null
            || (request.resource.data.commander is string && request.resource.data.commander.size() <= 300))
          && revealed(request.resource.data)
          && request.resource.data.get('secret', false) is bool
          && round(request.resource.data, 'joined') && round(request.resource.data, 'drop')
          && request.resource.data.at is string && request.resource.data.by is string;
        allow delete: if managed();

        // the player, with the code, while registration is open: in at once with a verified claim, otherwise waiting
        // for a TO to confirm; always with a commander, written in the same go in the private document
        function entry(d) {
          return d.uid == request.auth.uid && d.by == request.auth.uid
            && d.get('commander', null) == null && d.get('secret', false) == true
            && text(getAfter(/databases/$(database)/documents/tournaments/$(tid)/players/$(key)/private/deck).data, 'commander', 1, 300)
            && (d.get('deck', null) == null || text(d, 'deck', 1, 100))
            && d.get('invalid', false) is bool
            && stamp(d.get('at', null));
        }
        allow create: if holds(key)
          && tour().status == 'open' && tour().get('code', null) != null
          && request.resource.data.keys().hasOnly(['name', 'commander', 'secret', 'uid', 'pending', 'deck', 'invalid', 'at', 'by'])
          && text(request.resource.data, 'name', 1, 200)
          && entry(request.resource.data)
          && request.resource.data.get('pending', false) == !verified(key);
        // their commander and deck until round 1 (also when the TO added them)
        allow update: if holds(key)
          && tour().status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commander', 'secret', 'deck', 'invalid', 'uid', 'at', 'by'])
          && entry(request.resource.data);
        // whether they gave their decklist, until it's in the sheet
        allow update: if holds(key)
          && !tour().get('filed', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['list'])
          && request.resource.data.list is bool;
        // leaving the Swiss after the round being played, with a verified claim
        allow update: if verified(key)
          && tour().status == 'swiss'
          && resource.data.get('drop', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drop'])
          && request.resource.data.drop == tour().round;
        allow delete: if holds(key) && tour().status == 'open';

        // the decklist (a Moxfield link) and, until round 1, the commander: the player and the TOs see them, everyone
        // once the tournament is over
        // or, in place of the link, the photo of a deck of the app (docs/liste-mazzi.md, 8): only the player's app
        // reads the deck, so only the player writes it, until round 1 locks it for good
        function photo(d) {
          return d.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['cards', 'name', 'at', 'invalid']);
        }
        match /private/{doc} {
          allow read: if managed() || holds(key) || tour().status == 'done';
          allow create, update: if (managed() || holds(key))
            && doc == 'deck'
            && !tour().get('filed', false)
            && request.resource.data.keys().hasOnly(['link', 'commander', 'cards', 'name', 'at', 'invalid'])
            && (request.resource.data.get('link', null) == null
              || (text(request.resource.data, 'link', 1, 300)
                && request.resource.data.link.matches('https://(www[.])?moxfield[.]com/decks/[-_A-Za-z0-9]+/?')))
            && optional(request.resource.data, 'commander', 300)
            && (!photo(request.resource.data) || (holds(key) && tour().status == 'open'))
            && optional(request.resource.data, 'cards', 20000)
            && optional(request.resource.data, 'name', 200)
            && optional(request.resource.data, 'at', 40)
            && request.resource.data.get('invalid', false) is bool;
          // the player leaves before round 1 (the TO takes them off at any time): the photo goes with them
          allow delete: if managed() || (holds(key) && tour().status == 'open');
        }
      }
      // the log: a line for each change, written with it, signed and timed by the server. Its TOs read it, a player
      // the penalties given to their account; a player writes only the lines of their own actions; nobody changes or
      // deletes a line (an admin, from the console)
      match /log/{lid} {
        // a player's line tells what their write leaves (the line comes with the change, src/lib/tournaments.ts
        // logged): a line about something that isn't so is refused
        function told(d) {
          return (d.kind in ['report', 'confirm'] && d.get('round', null) is int && d.get('table', null) is int
              && result(d, getAfter(/databases/$(database)/documents/tournaments/$(tid)/matches/$('r' + string(d.round) + 't' + string(d.table))).data))
            || (d.kind == 'drop' && d.get('round', null) is int
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)/players/$(d.player)).data.get('drop', null) == d.round)
            || (d.kind in ['join', 'commander']
              && getAfter(/databases/$(database)/documents/tournaments/$(tid)/players/$(d.player)/private/deck).data.get('commander', null) == d.get('to', null))
            || (d.kind == 'leave' && !existsAfter(/databases/$(database)/documents/tournaments/$(tid)/players/$(d.player)));
        }
        // their table's result: entered by them and waiting, or confirmed by them on the opponent's word
        function result(d, m) {
          return d.player in [m.p1, m.p2]
            && (d.kind == 'report' ? m.get('reportedBy', null) == d.player && m.get('confirmed', null) == false
              : m.get('confirmed', null) == true && m.get('reportedBy', null) != d.player);
        }
        allow read: if managed() || (request.auth != null && resource.data.get('uid', null) == request.auth.uid);
        allow create: if request.resource.data.keys().hasOnly(['at', 'by', 'kind', 'round', 'table', 'player', 'from', 'to', 'infraction', 'text', 'uid'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && round(request.resource.data, 'round')
          && (request.resource.data.get('table', null) == null
            || (request.resource.data.table is int && request.resource.data.table >= 0 && request.resource.data.table <= 300))
          && optional(request.resource.data, 'player', 200)
          && optional(request.resource.data, 'from', 300) && optional(request.resource.data, 'to', 300)
          && optional(request.resource.data, 'infraction', 40) && optional(request.resource.data, 'text', 300)
          && optional(request.resource.data, 'uid', 128)
          && (managed()
            || (request.resource.data.kind in ['join', 'commander', 'leave', 'report', 'confirm', 'drop']
              && holds(request.resource.data.get('player', ''))
              && request.resource.data.get('uid', null) == null
              && told(request.resource.data)))
          && request.resource.data.kind in ['join', 'commander', 'leave', 'report', 'confirm', 'drop', 'undrop', 'add',
            'remove', 'accept', 'score', 'extra', 'pair', 'repair', 'cut', 'done', 'filed', 'unfiled', 'publish',
            'unpublish', 'cancel', 'warning', 'gameLoss', 'matchLoss', 'dq', 'note', 'deckCheck'];
      }
      // a Bo3 result, games won by p1, by p2 and drawn: as src/lib/swiss.ts validScore
      function score(d) {
        return d.get('score', null) == null
          || (d.score is list && d.score.size() == 3
            && d.score[0] is int && d.score[1] is int && d.score[2] is int
            && d.score[0] >= 0 && d.score[1] >= 0 && d.score[2] >= 0
            && d.score[0] <= 2 && d.score[1] <= 2 && d.score[0] + d.score[1] + d.score[2] <= 3);
      }
      match /matches/{mid} {
        allow read: if true;
        allow create, update: if managed()
          && request.resource.data.keys().hasOnly(['round', 'table', 'p1', 'p2', 'score', 'extra', 'reportedBy', 'confirmed'])
          && request.resource.data.round is int && request.resource.data.round >= 1 && request.resource.data.round <= 30
          && request.resource.data.table is int && request.resource.data.table >= 0 && request.resource.data.table <= 300
          && request.resource.data.p1 is string
          && (request.resource.data.get('p2', null) == null || request.resource.data.p2 is string)
          && score(request.resource.data)
          && (request.resource.data.get('extra', null) == null
            || (request.resource.data.extra is int && request.resource.data.extra >= 0 && request.resource.data.extra <= 60));
        allow delete: if managed();

        // the players of a table of the round being played, with verified claims: one reports the result, the
        // other confirms it; until then either can report it again, after it only the TO changes it
        allow update: if tour().status in ['swiss', 'cut']
          && resource.data.round == tour().round
          && resource.data.p2 != null
          && resource.data.get('confirmed', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'reportedBy', 'confirmed'])
          && ((request.resource.data.reportedBy in [resource.data.p1, resource.data.p2]
              && verified(request.resource.data.reportedBy)
              && request.resource.data.score != null && score(request.resource.data)
              && request.resource.data.confirmed == false)
            || (resource.data.score != null
              && request.resource.data.score == resource.data.score
              && request.resource.data.reportedBy == resource.data.reportedBy
              && request.resource.data.confirmed == true
              && ((resource.data.reportedBy == resource.data.p1 && verified(resource.data.p2))
                || (resource.data.reportedBy == resource.data.p2 && verified(resource.data.p1)))));
      }
    }

    // the circuit's leaderboard sheet of each year: every app reads them, without signing in; kept by the admins
    match /circuits/{year} {
      function tab(d, k) {
        return d.tabs.get(k, null) is string && d.tabs[k].matches('[0-9]{1,12}');
      }
      allow read: if true;
      allow write: if isAdmin()
        && year.matches('20[0-9]{2}')
        && request.resource.data.keys().hasOnly(['year', 'sheet', 'tabs', 'poty', 'at', 'by'])
        && request.resource.data.year == int(year)
        && request.resource.data.sheet is string
        && request.resource.data.sheet.matches('[-_A-Za-z0-9]{20,100}')
        && request.resource.data.tabs is map
        && request.resource.data.tabs.keys().hasOnly(['leaderboard', 's1', 's2', 'events'])
        && tab(request.resource.data, 'leaderboard') && tab(request.resource.data, 's1')
        && tab(request.resource.data, 's2') && tab(request.resource.data, 'events')
        && request.resource.data.poty is int
        && request.resource.data.poty >= 1 && request.resource.data.poty <= 100
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    // the name corrections applied to the tournament sheets by the nightly meta update ("where the sheet says X, it
    // means Y"): the update reads them without signing in; kept by the admins
    match /aliases/{id} {
      function valid(d) {
        return d.keys().hasOnly(['kind', 'key', 'from', 'to', 'year', 'drive', 'at', 'by'])
          && d.kind in ['commander', 'player']
          && d.key is string && d.key.size() > 0 && d.key.size() <= 200
          && d.from is string && d.from.size() > 0 && d.from.size() <= 200
          && d.to is string && d.to.size() > 0 && d.to.size() <= 200
          && (d.get('year', null) == null || (d.year is int && d.year >= 2020 && d.year <= 2100))
          && (d.get('drive', null) == null || (d.drive is string && d.drive.matches('[-_A-Za-z0-9]{20,100}')))
          && d.by == request.auth.uid;
      }
      allow read: if true;
      allow create, update: if isAdmin() && valid(request.resource.data);
      allow delete: if isAdmin();
    }

    // the banlist read from the format's site and published by an admin, as JSON: every app reads it, without signing in
    match /config/banlist {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'at', 'by'])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 100000
        && request.resource.data.by == request.auth.uid;
    }

    // reports sent from the app (src/lib/feedback.ts): any account can send one in its own name, only admins read
    // them, mark them done or delete them
    match /feedback/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'kind', 'text', 'page', 'about', 'version', 'device', 'at', 'done'])
        && request.resource.data.uid == request.auth.uid
        // the address to answer to is the account's own, never one typed in
        && (request.resource.data.get('email', null) == null || request.resource.data.email == request.auth.token.email)
        && request.resource.data.kind in ['bug', 'data', 'idea']
        && text(request.resource.data, 'text', 1, 2000)
        && optional(request.resource.data, 'name', 200)
        && optional(request.resource.data, 'page', 300)
        && optional(request.resource.data, 'about', 200)
        && text(request.resource.data, 'version', 1, 60)
        && text(request.resource.data, 'device', 1, 60)
        && text(request.resource.data, 'at', 1, 40)
        && request.resource.data.done == false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
    }

    // claims revoked by an admin: the account in `uid` can't claim that player again (anyone else can)
    match /revoked/{playerKey} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at', 'by'])
        && request.resource.data.uid is string
        && request.resource.data.by == request.auth.uid;
    }
  }
}
